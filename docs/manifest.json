{
  "manifest_version": 3,
  "name": "Steamprice",
  "version": "1.0.0",
  "description": "Skinpock inventory viewer with price history",
  "permissions": ["storage", "unlimitedStorage", "cookies", "tabs", "alarms"],
  "host_permissions": [
    "https://www.skinpock.com/*",
    "https://api.skinpock.com/*",
    "https://steamcommunity.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html"
  }
}
